{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itpppc/SEVER-GAME-prontera/rag/schema/knowledge_base.schema.json",
  "title": "Ramakien Knowledge Base",
  "description": "Structured records an AI NPC or Game Master retrieves to answer players about lore, quests, combat skills and crafting. Every record is also flattened into a searchable text chunk by rag/rag_npc.py.",
  "type": "object",
  "required": ["kb_version", "records"],
  "additionalProperties": false,
  "properties": {
    "kb_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "records": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/lore_entity" },
          { "$ref": "#/$defs/combat_skill" },
          { "$ref": "#/$defs/crafting_recipe" },
          { "$ref": "#/$defs/quest" }
        ]
      }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable slug, prefixed by record kind: char., loc., faction., item., skill., recipe., quest.",
      "type": "string",
      "pattern": "^(char|loc|faction|item|skill|recipe|quest)\\.[a-z0-9_]+$"
    },
    "i18n_text": {
      "description": "Same fact in Thai and English. Both are indexed, so a player can ask in either language.",
      "type": "object",
      "required": ["th", "en"],
      "additionalProperties": false,
      "properties": {
        "th": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "status": {
      "description": "live = in the game now; planned = designed but not released. The NPC must never promise planned content as available.",
      "enum": ["live", "planned"]
    },
    "spoiler_level": {
      "description": "0 = public, 1 = mild hint, 2 = full solution. The retriever drops records above the player's allowed level.",
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "game_ref": {
      "description": "Link to server data so answers stay consistent with rAthena (custom/db, custom/npc).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "integer", "minimum": 990000, "maximum": 990099 },
        "mob_id": { "type": "integer", "minimum": 31901, "maximum": 31999 },
        "npc_name": { "type": "string" },
        "map": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "type", "name", "summary", "status", "spoiler_level", "tags"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "name": { "$ref": "#/$defs/i18n_text" },
        "aliases": {
          "description": "Other spellings players type (Phra Ram, Rama, พระราม, Longka, Lanka).",
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "summary": { "$ref": "#/$defs/i18n_text" },
        "status": { "$ref": "#/$defs/status" },
        "spoiler_level": { "$ref": "#/$defs/spoiler_level" },
        "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "related": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "game_ref": { "$ref": "#/$defs/game_ref" },
        "source": {
          "description": "Where the fact comes from: ramakien (public-domain literature) or game_design (our own content).",
          "enum": ["ramakien", "game_design"]
        }
      }
    },
    "lore_entity": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "required": ["kind"],
      "properties": {
        "type": { "const": "lore_entity" },
        "kind": { "enum": ["character", "location", "landmark", "faction", "artifact"] },
        "faction": { "enum": ["ayodhya", "lanka", "neutral", "hermit"] },
        "personality": { "$ref": "#/$defs/i18n_text" },
        "voice_hint": {
          "description": "How this character speaks when an NPC role-plays them.",
          "$ref": "#/$defs/i18n_text"
        },
        "facilities": {
          "description": "For hubs and landmarks: services a player can use there.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "what"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/i18n_text" },
              "what": { "$ref": "#/$defs/i18n_text" },
              "status": { "$ref": "#/$defs/status" }
            }
          }
        }
      }
    },
    "combat_skill": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "required": ["user", "element", "target", "cast_time_s", "cooldown_s", "sp_cost"],
      "properties": {
        "type": { "const": "combat_skill" },
        "user": { "description": "Class or monster id that uses it.", "type": "string" },
        "element": { "enum": ["neutral", "holy", "fire", "water", "wind", "earth", "poison", "dark", "ghost", "undead"] },
        "target": { "enum": ["self", "single", "area", "line", "party"] },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 10 },
        "cast_time_s": { "type": "number", "minimum": 0 },
        "cooldown_s": { "type": "number", "minimum": 0 },
        "sp_cost": { "type": "integer", "minimum": 0 },
        "effect": { "$ref": "#/$defs/i18n_text" },
        "counter_tip": { "$ref": "#/$defs/i18n_text" }
      }
    },
    "crafting_recipe": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "required": ["output", "ingredients", "station"],
      "properties": {
        "type": { "const": "crafting_recipe" },
        "output": {
          "type": "object",
          "required": ["name", "qty"],
          "properties": {
            "name": { "$ref": "#/$defs/i18n_text" },
            "qty": { "type": "integer", "minimum": 1 },
            "item_id": { "type": "integer" }
          }
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "qty"],
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/i18n_text" },
              "qty": { "type": "integer", "minimum": 1 },
              "item_id": { "type": "integer" },
              "where_to_get": { "$ref": "#/$defs/i18n_text" }
            }
          }
        },
        "zeny_cost": { "type": "integer", "minimum": 0 },
        "station": { "$ref": "#/$defs/i18n_text" },
        "required_level": { "type": "integer", "minimum": 1, "maximum": 175 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "quest": {
      "allOf": [{ "$ref": "#/$defs/base" }],
      "type": "object",
      "required": ["giver", "min_level", "steps", "rewards"],
      "properties": {
        "type": { "const": "quest" },
        "giver": { "type": "string" },
        "min_level": { "type": "integer", "minimum": 1 },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["n", "do", "spoiler_level"],
            "additionalProperties": false,
            "properties": {
              "n": { "type": "integer", "minimum": 1 },
              "do": { "$ref": "#/$defs/i18n_text" },
              "spoiler_level": { "$ref": "#/$defs/spoiler_level" }
            }
          }
        },
        "rewards": { "type": "array", "items": { "$ref": "#/$defs/i18n_text" } }
      }
    },
    "chunk": {
      "description": "One retrievable passage (rag/data/chunks.jsonl). Long prose that does not fit a structured record lives here.",
      "type": "object",
      "required": ["chunk_id", "lang", "title", "text", "topic", "status", "spoiler_level"],
      "additionalProperties": false,
      "properties": {
        "chunk_id": { "type": "string", "pattern": "^[a-z0-9_.]+\\.(th|en)$" },
        "group": { "description": "Same passage in another language shares the group.", "type": "string" },
        "lang": { "enum": ["th", "en"] },
        "title": { "type": "string" },
        "text": { "type": "string", "minLength": 80 },
        "topic": { "enum": ["hub", "dungeon", "questline", "lore", "crafting", "combat"] },
        "status": { "$ref": "#/$defs/status" },
        "spoiler_level": { "$ref": "#/$defs/spoiler_level" },
        "related": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
