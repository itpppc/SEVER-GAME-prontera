# SEVER GAME Prontera: local settings.
# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# rAthena source checkout (relative to repo root) and the git ref to build
RATHENA_DIR=rathena
RATHENA_REF=master

# Client date this server talks to (YYYYMMDD). Must match your patched client exe.
PACKETVER=20211103

# Database (MariaDB/MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ragnarok
LOG_DB_NAME=ragnarok_log
DB_USER=ragnarok
DB_PASS=CHANGE_ME_db_password

# Login <-> char <-> map inter-server account (replaces rAthena's default s1/p1)
INTER_USER=CHANGE_ME_inter_user
INTER_PASS=CHANGE_ME_inter_pass

# Server identity and network
SERVER_NAME=Prontera
# IP the client connects to for char/map. 127.0.0.1 = this PC only, LAN IP for friends, public IP for internet.
PUBLIC_IP=127.0.0.1

# Allow new accounts via the _M / _F suffix at the login screen (yes|no)
NEW_ACCOUNT=yes
